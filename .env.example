# ═══════════════════════════════════════════════════════════════════════════
# Credenciais e Configuração do Portal de Gestão Renova
#
# SEGURANÇA: Copie este arquivo para .env e preencha com as credenciais reais.
# NUNCA commitar .env no Git — ele está em .gitignore.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Banco de Dados MySQL (Genesis) ───────────────────────────────────────
DB_HOST=ip_do_servidor_aqui
DB_PORT=porta_aqui
DB_USER=usuario_aqui
DB_PASSWORD=seu_senha_aqui
DB_DATABASE=nome_do_banco_aqui

# ─── Google Sheets (IDs das Planilhas) ────────────────────────────────────
# Contas a Pagar
GS_CONTAS_PAGAR_ID=ID_DA_PLANILHA_AQUI

# Contas a Receber
GS_CONTAS_RECEBER_ID=ID_DA_PLANILHA_AQUI

# Manual da Empresa (Organograma)
GS_MANUAL_EMPRESA_ID=1zHJwKw88K0ArhN9qpWM8T0bzSMFpglebn5PZIdfgev0

# Ordens de Serviço
GS_ORDENS_SERVICO_ID=1oppOgyOa6u4zVGd4lXABQQ-FEt5bzeU6Qqlo98aqqpc

# Ordens de Serviço Finalizadas
GS_ORDENS_FINALIZADAS_ID=13yPY1Jxz7ocnD9RA3siVyAfj6k64WzzKDZjFbdABzeA

# Pasta de Fotos no Google Drive
GS_FOTOS_PASTA_ID=1TXIMglGCPwrkgN3sJRbN-_GHxLqP4bH4

# ─── Apps Script URLs ─────────────────────────────────────────────────────
# Copie a URL /exec da implantação do Apps Script aqui
APPS_SCRIPT_CONTAS_PAGAR_URL=https://script.google.com/macros/s/SEU_ID_AQUI/exec
APPS_SCRIPT_CONTAS_RECEBER_URL=https://script.google.com/macros/s/SEU_ID_AQUI/exec
APPS_SCRIPT_MANUAL_EMPRESA_URL=https://script.google.com/macros/s/SEU_ID_AQUI/exec

# ─── Integração (Cron Job na VPS) ─────────────────────────────────────────
# Token de serviço do Apps Script (para scripts rodarem automaticamente)
SYNC_API_URL=https://script.google.com/macros/s/SEU_ID_AQUI/exec
SYNC_TOKEN=seu_token_servico_aqui

# ─── Resultado Semanal (extrair-resultado-semanal.js) ─────────────────────
# URL /exec do apps-script/resultado-semanal.gs e a CHAVE_SERVICO daquele projeto
RS_API_URL=https://script.google.com/macros/s/SEU_ID_AQUI/exec
RS_SYNC_TOKEN=chave_hexadecimal_longa_aqui
